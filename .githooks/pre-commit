#!/usr/bin/env bash
# pre-commit: block conflict markers and broken shell scripts
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if git show ":$f" | grep -qE '^(<<<<<<<|=======|>>>>>>>)( |$)'; then
    echo "pre-commit: conflict markers found in $f"
    fail=1
  fi
  case "$f" in
    *.sh)
      if ! git show ":$f" | bash -n; then
        echo "pre-commit: syntax error in $f"
        fail=1
      fi
      ;;
  esac
done
if [ "$fail" -ne 0 ]; then
  echo "Commit blocked. Fix the problems above and commit again."
fi
exit $fail
